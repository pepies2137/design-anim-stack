# Skopiuj do .env (albo wklej te zmienne w Dokploy -> Environment). .env jest w .gitignore.
# Sekrety trzymamy w vaulcie: `cred --raw design-anim/od_api_token`, `cred --raw design-anim/ma_pass`.

# --- OpenDesign ---
# Haslo HTTP Basic Auth dla UI/API. User jest staly: open-design.
OD_API_TOKEN=
# Opcjonalnie: lista dozwolonych Origin (gdy wystawiasz UI pod domena)
OD_ALLOWED_ORIGINS=
# Na jakim interfejsie hosta publikowac porty (0.0.0.0 = LAN + tailscale; 100.86.96.24 = tylko tailnet)
OD_BIND=0.0.0.0
OD_MEM_LIMIT=1024m

# --- motion-anything (caddy basic auth) ---
MOTION_USER=motion
MOTION_PASS=
MA_BIND=0.0.0.0
MA_MEM_LIMIT=1536m

# --- silnik opencode (klucz OmniRoute) ---
OPENCODE_MODEL=pepies/programowanieciezkie
OPENCODE_PEPIES_BASE_URL=https://router.pepies.pl/v1
OPENCODE_PEPIES_KEY=
OPENCODE_GO_KEY=
