{
  "$schema": "https://opencode.ai/config.json",
  "model": "pepies/programowanieciezkie",
  "small_model": "pepies/programowanieciezkie",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "websearch": "allow"
  },
  "provider": {
    "pepies": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute (router.pepies.pl)",
      "options": {
        "baseURL": "https://router.pepies.pl/v1"
      },
      "models": {
        "programowanieciezkie": {
          "name": "Programowanie ciezkie (combo OmniRoute)",
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    }
  }
}
